# =============================================================================
# Waterly Backend - Environment Variables
# =============================================================================
# Copiar este archivo a .env y modificar los valores segun tu entorno:
#   cp .env.example .env
# =============================================================================

# --- THINGSBOARD ---
# Token de acceso del dispositivo en ThingsBoard
# Se obtiene en ThingsBoard -> Dispositivos -> Waterly_ESP32 -> Copiar Access Token
TB_ACCESS_TOKEN=x35f744geqt5lgsnlwsk

# Hostname del servicio ThingsBoard (Docker) o IP si es externo
TB_HOST=thingsboard

# Credenciales de admin de ThingsBoard (para auto-configuracion de dispositivos)
TB_ADMIN_USER=tenant@thingsboard.org
TB_ADMIN_PASS=tenant

# --- MOSQUITTO (MQTT Broker) ---
# Hostname del servicio Mosquitto (Docker) o IP
MOSQUITTO_HOST=mosquitto

# --- INFLUXDB ---
# URL de InfluxDB (Docker: http://influxdb:8086, externo: http://tu-ip:8086)
INFLUX_URL=http://influxdb:8086

# Token de admin de InfluxDB
INFLUX_TOKEN=admin

# Organizacion y bucket de InfluxDB
INFLUX_ORG=waterly_org
INFLUX_BUCKET=sensor_data

# =============================================================================
# Variables opcionales (no requieren cambio en la mayoria de casos)
# =============================================================================

# Puerto del broker MQTT (default: 1883)
# MQTT_PORT=1883

# Timeout del burst de mediciones en segundos (default: 20)
# BURST_TIMEOUT_S=20

# Numero default de muestras para calibracion/training/analisis
# DEFAULT_SAMPLES=5

# Modo ML por defecto: DEVIATION o PLSR
# DEFAULT_MODE=DEVIATION

# Savitzky-Golay filter window length (default: 5)
# SG_WINDOW=5

# Savitzky-Golay filter polynomial order (default: 2)
# SG_POLYORDER=2

# Habilitar/deshabilitar Savitzky-Golay filtering (default: true)
# SG_ENABLED=true

# Path del modelo ML persistente (default: /app/data/waterly_model.pkl)
# MODEL_PATH=/app/data/waterly_model.pkl
